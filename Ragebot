----------------------------------------------------
-- Core Logic & Target Selection
----------------------------------------------------

local function isValidTarget(player)
	if not player or not player.Parent then return false end
	local hrp = getHRP(player)
	local humanoid = getHumanoid(player)
	local isTeammate = (LocalPlayer.Team ~= nil and player.Team == LocalPlayer.Team)

	return hrp ~= nil and humanoid ~= nil and humanoid.Health > 0 and not isTeammate
end

local function getClosestEnemyPlayer()
	local myHRP = getHRP(LocalPlayer)
	if not myHRP then return nil, math.huge end

	local closestPlayer = nil
	local shortestDistance = math.huge

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and isValidTarget(player) then
			local hrp = getHRP(player)
			if hrp then
				local dist = (myHRP.Position - hrp.Position).Magnitude
				if dist < shortestDistance then
					shortestDistance = dist
					closestPlayer = player
				end
			end
		end
	end

	return closestPlayer, shortestDistance
end

----------------------------------------------------
-- Execution Control
----------------------------------------------------

local function stopFollowing()
	isFollowing = false
	currentTarget = nil
	isTargetLost = false

	ToggleButton.Text = "Auto Follow: OFF"
	ToggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
	StatusLabel.Text = "State: Idle\nTarget: None\nDistance: 0 studs"

	pcall(function()
		RunService:UnbindFromRenderStep(RENDER_BIND_NAME)
	end)

	local myHRP = getHRP(LocalPlayer)
	if myHRP then
		myHRP.AssemblyLinearVelocity = Vector3.zero
		myHRP.AssemblyAngularVelocity = Vector3.zero
	end
end

local function startFollowing()
	if isFollowing then return end
	isFollowing = true

	ToggleButton.BackgroundColor3 = Color3.fromRGB(50, 200, 80)
	ToggleButton.Text = "Auto Follow: ON"

	-- Asynchronous Periodic Search Loop
	task.spawn(function()
		while isFollowing do
			local closestEnemy, closestDist = getClosestEnemyPlayer()

			if closestEnemy then
				if not isValidTarget(currentTarget) then
					if currentTarget ~= nil then
						-- Display transient lost status before switching
						isTargetLost = true
						task.wait(0.4)
						isTargetLost = false
					end
					currentTarget = closestEnemy
				elseif closestEnemy ~= currentTarget then
					local myHRP = getHRP(LocalPlayer)
					local targetHRP = getHRP(currentTarget)
					if myHRP and targetHRP then
						local currentDist = (myHRP.Position - targetHRP.Position).Magnitude
						if closestDist < (currentDist - distanceThreshold) then
							currentTarget = closestEnemy
						end
					end
				end
			elseif not isValidTarget(currentTarget) then
				if currentTarget ~= nil then
					isTargetLost = true
					task.wait(0.4)
					isTargetLost = false
				end
				currentTarget = nil
			end

			task.wait(searchInterval)
		end
	end)

	-- Synchronized Priority Binding
	RunService:BindToRenderStep(
		RENDER_BIND_NAME,
		Enum.RenderPriority.Camera.Value - 1,
		function()
			if not isFollowing then return end

			local myHRP = getHRP(LocalPlayer)
			if not myHRP then return end

			if isTargetLost then
				StatusLabel.Text = "State: Target Lost!\nTarget: Searching...\nDistance: N/A"
				return
			end

			if isValidTarget(currentTarget) then
				local targetHRP = getHRP(currentTarget)
				if targetHRP then
					local currentDist = math.floor((myHRP.Position - targetHRP.Position).Magnitude)

					-- Freeze momentum
					myHRP.AssemblyLinearVelocity = Vector3.zero
					myHRP.AssemblyAngularVelocity = Vector3.zero

					-- Smooth position interpolation
					local targetCFrame = targetHRP.CFrame * CFrame.new(0, followHeight, 0)
					myHRP.CFrame = myHRP.CFrame:Lerp(targetCFrame, lerpSpeed)

					StatusLabel.Text = string.format(
						"State: Following\nTarget: %s (@%s)\nDistance: %d studs",
						currentTarget.DisplayName,
						currentTarget.Name,
						currentDist
					)
				end
			else
				StatusLabel.Text = "State: Searching...\nTarget: None\nDistance: N/A"
			end
		end
	)
end

