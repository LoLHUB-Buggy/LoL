        return b
    end

    local function addToggle(text, var, color)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(0.43, 0, 0, btnH)
        b.Position = UDim2.new(0.05 + ((y % 2 == 1) and 0.52 or 0), 0, 0, y)
        b.BackgroundColor3 = color
        b.Text = text .. ": OFF"
        b.TextColor3 = Color3.fromRGB(255, 255, 255)
        b.TextScaled = true
        b.Font = Enum.Font.GothamBold
        b.Parent = frame
        b.MouseButton1Click:Connect(function()
            _G.LoL[var] = not _G.LoL[var]
            b.Text = text .. ": " .. (_G.LoL[var] and "ON" or "OFF")
            b.BackgroundColor3 = _G.LoL[var] and color or Color3.fromRGB(color.R*0.3, color.G*0.3, color.B*0.3)
