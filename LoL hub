-- ==================== RAGEBOT LOOP (WORKING) ====================
game:GetService("RunService").Heartbeat:Connect(function()
    pcall(function()
        -- VOID KEEP
        if _G.LoL.Void then
            local lp = game.Players.LocalPlayer
            if lp and lp.Character then
                local root = lp.Character:FindFirstChild("HumanoidRootPart")
                if root and root.Position.Y > -900000 then
                    root.CFrame = CFrame.new(Vector3.new(root.Position.X, _G.LoL.VoidY, root.Position.Z))
                end
                for _, part in pairs(lp.Character:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
            end
        end

        -- AIMBOT + RAGE + TRIGGER + ANTIAIM
        if _G.LoL.Aim or _G.LoL.Rage then
            local cam = workspace.CurrentCamera
            if not cam then return end

            local lp = game.Players.LocalPlayer
            if not lp or not lp.Character then return end

            local headPos = lp.Character:FindFirstChild("Head")
            if not headPos then return end

            local target = nil
            local minDist = math.huge

            for _, plr in pairs(game.Players:GetPlayers()) do
                if plr ~= lp and plr.Character and plr.Character:FindFirstChild("Humanoid") and plr.Character.Humanoid.Health > 0 then
                    local h = plr.Character:FindFirstChild("Head")
                    if h then
                        local dist = (h.Position - headPos.Position).Magnitude
                        if dist < minDist then
                            minDist = dist
                            target = h
                        end
                    end
                end
            end

            if target then
                local screenPos, onScreen = cam:WorldToViewportPoint(target.Position)
                if onScreen then
                    local center = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
                    local fov = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                    if fov <= (_G.LoL.FOV or 90) then
                        -- RAGE MODE (instant snap)
                        if _G.LoL.Rage then
                            cam.CFrame = CFrame.new(cam.CFrame.Position, target.Position)
                        end
                        
                        -- AIM MODE (smooth)
                        if _G.LoL.Aim then
                            cam.CFrame = cam.CFrame:Lerp(CFrame.new(cam.CFrame.Position, target.Position), 0.3)
                        end

                        -- TRIGGERBOT (auto shoot)
                        if _G.LoL.Trigger then
                            local vim = game:GetService("VirtualInputManager")
                            if vim then
                                vim:SendMouseButtonEvent(0, 0, true, Enum.UserInputType.MouseButton1, false)
                                task.wait(0.015)
                                vim:SendMouseButtonEvent(0, 0, false, Enum.UserInputType.MouseButton1, false)
                            end
                        end

                        -- ANTIAIM (jitter)
                        if _G.LoL.AntiAim then
                            local j = math.sin(tick()*14)*0.7
                            local c = cam.CFrame
                            local a = c:ToEulerAnglesYXZ()
                            a = Vector3.new(a.X + j, a.Y + j*0.5, a.Z)
                            cam.CFrame = CFrame.new(c.Position) * CFrame.Angles(a.X, a.Y, a.Z)
                        end

                        if statusLabel then statusLabel.Text = "🎯 " .. target.Parent.Name end
                        return
                    end
                end
            end
            if statusLabel then 
                if not target then statusLabel.Text = "🔍 No target" end
            end
        end
    end)
end)

