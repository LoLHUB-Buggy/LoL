-- Helper Functions
local function unanchorSelf()
	local myChar = LocalPlayer.Character
	if myChar and myChar:FindFirstChild("HumanoidRootPart") then
		myChar.HumanoidRootPart.Anchored = false
	end
end

local function stopFollowing()
	isFollowing = false
	ToggleBtn.Text = "Follow: OFF"
	ToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
	unanchorSelf()
end

-- Refresh Player List with Filter
local function refreshPlayerList()
	for _, child in ipairs(PlayerListFrame:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end
	
	local filter = string.lower(SearchBox.Text)
	local count = 0
	
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			local displayName = string.lower(plr.DisplayName)
			local username = string.lower(plr.Name)
			
			if filter == "" or string.find(displayName, filter) or string.find(username, filter) then
				count = count + 1
				local Btn = Instance.new("TextButton")
				Btn.Size = UDim2.new(1, 0, 0, 25)
				Btn.BackgroundColor3 = (selectedPlayer == plr) and Color3.fromRGB(0, 140, 255) or Color3.fromRGB(40, 40, 40)
				Btn.Text = plr.DisplayName .. " (@" .. plr.Name .. ")"
				Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
				Btn.Font = Enum.Font.SourceSans
				Btn.TextSize = 12
				Btn.Parent = PlayerListFrame
				
				Btn.MouseButton1Click:Connect(function()
					selectedPlayer = plr
					refreshPlayerList()
				end)
			end
		end
	end
	
	PlayerListFrame.CanvasSize = UDim2.new(0, 0, 0, count * 25)
end

SearchBox:GetPropertyChangedSignal("Text"):Connect(refreshPlayerList)

-- Auto-Select Next Player on Leave
Players.PlayerRemoving:Connect(function(plr)
	if selectedPlayer == plr then
		local remainingPlayers = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer then
				table.insert(remainingPlayers, p)
			end
		end
		
		if #remainingPlayers > 0 then
			selectedPlayer = remainingPlayers[1]
		else
			selectedPlayer = nil
			stopFollowing()
		end
	end
	refreshPlayerList()
end)

Players.PlayerAdded:Connect(refreshPlayerList)
refreshPlayerList()

-- Height Limit Input
HeightBox.FocusLost:Connect(function()
	local val = tonumber(HeightBox.Text)
	if val then
		heightOffset = math.clamp(math.floor(val), 1, 50)
	end
	HeightBox.Text = tostring(heightOffset)
end)

-- Minimize Button Logic
MinimizeBtn.MouseButton1Click:Connect(function()
	isMinimized = not isMinimized
	if isMinimized then
		ContentFrame.Visible = false
		MainFrame.Size = UDim2.new(0, 240, 0, 32)
		MinimizeBtn.Text = "+"
	else
		ContentFrame.Visible = true
		MainFrame.Size = UDim2.new(0, 240, 0, 360)
		MinimizeBtn.Text = "_"
	end
end)

-- Toggle Anti-Aim Button Logic
AntiAimBtn.MouseButton1Click:Connect(function()
	isAntiAim = not isAntiAim
	if isAntiAim then
		AntiAimBtn.Text = "Anti-Aim: ON"
		AntiAimBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 40)
	else
		AntiAimBtn.Text = "Anti-Aim: OFF"
		AntiAimBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
	end
end)

-- Toggle Follow Button Logic
ToggleBtn.MouseButton1Click:Connect(function()
	if not selectedPlayer then
		ToggleBtn.Text = "Select a Player!"
		task.wait(1)
		ToggleBtn.Text = isFollowing and "Follow: ON" or "Follow: OFF"
		return
	end
	
	isFollowing = not isFollowing
	
	if isFollowing then
		ToggleBtn.Text = "Follow: ON"
		ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 40)
	else
		stopFollowing()
	end
end)

-- Render Loop: Positional Lock, Anti-Aim Rotation, Distance Tracker, & Auto-Respawn
RunService.RenderStepped:Connect(function()
	local myChar = LocalPlayer.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	
	-- Increment Spin Angle for Anti-Aim
	spinAngle = (spinAngle + 45) % 360
	local rotationCFrame = CFrame.Angles(0, math.rad(spinAngle), 0)
	
	-- Distance Indicator Update
	if selectedPlayer and selectedPlayer.Character and selectedPlayer.Character:FindFirstChild("HumanoidRootPart") and myRoot then
		local targetRoot = selectedPlayer.Character.HumanoidRootPart
		local dist = math.floor((myRoot.Position - targetRoot.Position).Magnitude)
		DistanceLabel.Text = "Distance: " .. tostring(dist) .. " studs"
	else
		DistanceLabel.Text = "Distance: Target Dead / Spawning..."
	end
	
	-- Active Follow & Anti-Aim Execution
	if isFollowing and selectedPlayer then
		local targetChar = selectedPlayer.Character
		local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
		local humanoid = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
		
		-- Check if target is alive & loaded
		if myChar and myRoot and targetRoot and humanoid and humanoid.Health > 0 then
			myRoot.Anchored = true
			myRoot.AssemblyLinearVelocity = Vector3.zero
			myRoot.AssemblyAngularVelocity = Vector3.zero
			
			local basePosition = targetRoot.CFrame * CFrame.new(0, heightOffset, 0)
			if isAntiAim then
				myRoot.CFrame = CFrame.new(basePosition.Position) * rotationCFrame
			else
				myRoot.CFrame = basePosition
			end
		else
			unanchorSelf()
		end
	elseif isAntiAim and myRoot then
		-- Apply rotation alone if Anti-Aim is ON without follow mode
		myRoot.CFrame = CFrame.new(myRoot.Position) * rotationCFrame
	end
end)
