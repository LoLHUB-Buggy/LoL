-- Functions
local function updateFOVDisplay()
	fovLabel.Text = "FOV: " .. math.floor(currentFOV)
	local fovPercent = (currentFOV - 50) / (500 - 50)
	fovSliderFill.Size = UDim2.new(fovPercent, 0, 1, 0)
	camera.FieldOfView = currentFOV
end

local function adjustFOV(amount)
	currentFOV = math.clamp(currentFOV + amount, 50, 500)
	updateFOVDisplay()
end

local function resetFOV()
	currentFOV = 70
	updateFOVDisplay()
end

local function updateButtonState()
	if cameraLocked then
		toggleButton.Text = "Lock Camera: ON"
		toggleButton.BackgroundColor3 = Color3.fromRGB(50, 150, 50)
		statusLabel.Text = "Status: LOCKED ✓\n\nPress TAB to toggle\nPress Q to open/close GUI"
		infoLabel.Visible = true
	else
		toggleButton.Text = "Lock Camera: OFF"
		toggleButton.BackgroundColor3 = Color3.fromRGB(150, 50, 50)
		statusLabel.Text = "Status: Unlocked\n\nPress TAB to toggle\nPress Q to open/close GUI"
		infoLabel.Visible = false
	end
end

local function toggleCameraLock()
	cameraLocked = not cameraLocked
	updateButtonState()
end

local function toggleGui()
	mainFrame.Visible = not mainFrame.Visible
end

-- Button Connections
toggleButton.MouseButton1Click:Connect(toggleCameraLock)
closeButton.MouseButton1Click:Connect(toggleGui)
fovDecButton.MouseButton1Click:Connect(function()
	adjustFOV(-10)
end)
fovIncButton.MouseButton1Click:Connect(function()
	adjustFOV(10)
end)
resetFovButton.MouseButton1Click:Connect(resetFOV)

-- FOV Slider Click
fovSlider.InputBegan:Connect(function(input, gameProcessed)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		local sliderSize = fovSlider.AbsoluteSize.X
		local clickPosition = userInputService:GetMouseLocation().X - fovSlider.AbsolutePosition.X
		local percent = math.clamp(clickPosition / sliderSize, 0, 1)
		currentFOV = 50 + (percent * 450)
		updateFOVDisplay()
	end
end)

-- Keyboard Input
userInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	
	if input.KeyCode == Enum.KeyCode.Tab then
		toggleCameraLock()
	elseif input.KeyCode == Enum.KeyCode.Q then
		toggleGui()
	end
end)

-- Instant Camera Lock Loop
runService.RenderStepped:Connect(function()
	if cameraLocked and character and humanoidRootPart then
		local targetPosition = humanoidRootPart.Position + lockOffset
		camera.CFrame = CFrame.new(targetPosition, targetPosition + Vector3.new(0, 0, -1))
		camera.FieldOfView = currentFOV
	end
end)

-- Handle character respawn
player.CharacterAdded:Connect(function(newCharacter)
	character = newCharacter
	humanoidRootPart = character:WaitForChild("HumanoidRootPart")
end)

print("✓ Camera Lock Script Loaded!")
print("TAB - Toggle camera lock")
print("Q - Open/Close GUI")
