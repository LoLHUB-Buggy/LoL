-- ==================== UNLOCK FUNCTIONS ====================
function unlockAll(what)
    local success = false
    local rs = game:GetService("ReplicatedStorage")
    local lp = game.Players.LocalPlayer
    if not lp then return end

    local remoteName = what == "skins" and "UnlockSkin" or what == "wraps" and "UnlockWrap" or "UnlockFinisher"
    local remote = rs:FindFirstChild(remoteName) or rs:FindFirstChild("RemoteEvent")

    if remote and remote:IsA("RemoteEvent") then
        local max = what == "skins" and 300 or what == "wraps" and 200 or 100
        for i = 1, max do
            pcall(function() remote:FireServer(i, "Unlock") end)
        end
        success = true
    end

    if getgc then
        for _, v in pairs(getgc(true)) do
            if type(v) == "table" then
                pcall(function()
                    local key = what == "skins" and "SkinData" or what == "wraps" and "WrapData" or "FinisherData"
                    if v[key] then
                        for k, data in pairs(v) do
                            if type(data) == "table" and data.Owned ~= nil then data.Owned = true end
                        end
                    end
                    local list = what == "skins" and "Skins" or what == "wraps" and "Wraps" or "Finishers"
                    if v[list] and type(v[list]) == "table" then
                        for k, item in pairs(v[list]) do
                            if type(item) == "table" then item.Unlocked = true; item.Owned = true end
                        end
                    end
                end)
            end
        end
        success = true
    end

    local stat = lp:FindFirstChild("leaderstats")
    if stat then
        local name = what == "skins" and "SkinsUnlocked" or what == "wraps" and "WrapsUnlocked" or "FinishersUnlocked"
        local s = stat:FindFirstChild(name)
        if s then s.Value = 9999 end
        success = true
    end

    if what == "finishers" then
        local of = lp:FindFirstChild("OwnedFinishers")
        if of and of:IsA("IntValue") then of.Value = 9999 end
        success = true
    end

    return success
end

-- ==================== VOID FUNCTIONS ====================
function teleportVoid()
    local lp = game.Players.LocalPlayer
    if not lp or not lp.Character then return end
    local root = lp.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    savedPos = root.Position
    root.CFrame = CFrame.new(Vector3.new(root.Position.X, _G.LoL_VoidY, root.Position.Z))
    if statusLabel then statusLabel.Text = "🌌 In Void" end
end

function teleportBack()
    local lp = game.Players.LocalPlayer
    if not lp or not lp.Character then return end
    local root = lp.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    if savedPos then
        root.CFrame = CFrame.new(savedPos)
        savedPos = nil
    end
    if statusLabel then statusLabel.Text = "🌌 Returned" end
end

