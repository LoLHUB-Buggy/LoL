-- ══════════════════════════════════
--  VOID SPAM (FE-safe)
-- ══════════════════════════════════
local voidThread = nil

local function startVoidSpam()
    voidThread = task.spawn(function()
        while voidSpamEnabled do
            local hrp = getHRP()
            local h   = getHuman()
            if hrp then
                hrp.CFrame = CFrame.new(hrp.Position.X, -9000000, hrp.Position.Z)
            end
            task.wait(0.08)
            if h and h.Health > 0 then
                h.Health = 0
            end
            local elapsed = 0
            repeat
                task.wait(0.05)
                elapsed = elapsed + 0.05
            until (getHRP() ~= nil and getHuman() ~= nil and getHuman().Health > 0)
                  or elapsed > 6
            task.wait(0.05)
        end
    end)
end

local function stopVoidSpam()
    if voidThread then
        task.cancel(voidThread)
        voidThread = nil
    end
end

VoidBtn.MouseButton1Click:Connect(function()
    voidSpamEnabled = not voidSpamEnabled
    if voidSpamEnabled then
        activateBtn(VoidDot, VoidBar, VoidStatus, Color3.fromRGB(50, 220, 50))
        startVoidSpam()
    else
        deactivateBtn(VoidDot, VoidBar, VoidStatus)
        stopVoidSpam()
    end
end)

-- ══════════════════════════════════
--  SHARED AIM LOGIC
-- ══════════════════════════════════
local AIM_FOV  = 360
local AIM_BONE = "HumanoidRootPart"

local function getScreenAngle(worldPos)
    local sp, onScreen = Camera:WorldToScreenPoint(worldPos)
    if not onScreen then return math.huge end
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local delta  = Vector2.new(sp.X, sp.Y) - center
    return math.deg(math.atan2(delta.Magnitude, Camera.ViewportSize.Y / 2))
end

local function isEnemy(player)
    if player == LocalPlayer then return false end
    if LocalPlayer.Team and player.Team then
        return LocalPlayer.Team ~= player.Team
    end
    return true
end

local function getBestTarget()
    local best, bestAng = nil, AIM_FOV
    for _, p in ipairs(Players:GetPlayers()) do
        if not isEnemy(p) then continue end
        local c = p.Character
        if not c then continue end
        local bone = c:FindFirstChild(AIM_BONE)
        if not bone then continue end
        local h = c:FindFirstChildOfClass("Humanoid")
        if not h or h.Health <= 0 then continue end
        local ang = getScreenAngle(bone.Position)
        if ang < bestAng then
            bestAng = ang
            best    = p
        end
    end
    return best
end

local function fireTool()
    local c = getChar()
    if not c then return end
    local tool = c:FindFirstChildOfClass("Tool")
    if not tool then return end
    for _, name in ipairs({"Fire","Shoot","Activate","Attack","Use"}) do
        local r = tool:FindFirstChild(name)
        if r and r:IsA("RemoteEvent") then
            r:FireServer()
            return
        end
    end
    pcall(function() tool:Activate() end)
end

-- ══════════════════════════════════
--  AIMBOT (FE-safe)
--  Full auto: scan + camera snap +
--  fire every RenderStepped tick
-- ══════════════════════════════════
local aimbotConn = nil

local function startAimbot()
    aimbotConn = RunService.RenderStepped:Connect(function()
        if not aimbotEnabled then return end
        local target = getBestTarget()
        if not target then return end
        local c    = target.Character
        if not c then return end
        local bone = c:FindFirstChild(AIM_BONE)
        if not bone then return end
        -- hard snap camera onto target
        local dir = (bone.Position - Camera.CFrame.Position).Unit
        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, Camera.CFrame.Position + dir)
        fireTool()
    end)
end

local function stopAimbot()
    if aimbotConn then
        aimbotConn:Disconnect()
        aimbotConn = nil
    end
end

AimBtn.MouseButton1Click:Connect(function()
    aimbotEnabled = not aimbotEnabled
    if aimbotEnabled then
        activateBtn(AimDot, AimBar, AimStatus, Color3.fromRGB(220, 50, 50))
        startAimbot()
    else
        deactivateBtn(AimDot, AimBar, AimStatus)
        stopAimbot()
    end
end)

-- ══════════════════════════════════
--  SILENT AIM (FE-safe)
--  Runtime camera alignment:
--  smoothly lerps camera toward
--  target every frame WITHOUT
--  snapping — looks legit, still
--  locks onto enemy for shots.
--  Fires weapon only when camera
--  is within 3° of target (tight
--  hit cone = no wasted shots).
-- ══════════════════════════════════
local silentAimConn  = nil
local SILENT_LERP    = 0.18   -- smoothing factor (0.0 = no move, 1.0 = instant snap)
local SILENT_HIT_FOV = 3      -- degrees — fire only when this close to target

local function startSilentAim()
    silentAimConn = RunService.RenderStepped:Connect(function()
        if not silentAimEnabled then return end

        local target = getBestTarget()
        if not target then return end
        local c    = target.Character
        if not c then return end
        local bone = c:FindFirstChild(AIM_BONE)
        if not bone then return end

        -- Vector from camera to bone
        local targetDir = (bone.Position - Camera.CFrame.Position).Unit

        -- Current camera look direction
        local currentDir = Camera.CFrame.LookVector

        -- Smooth lerp between current direction and target direction
        -- This runs every frame → gives fluid tracking motion
        local lerpedDir = currentDir:Lerp(targetDir, SILENT_LERP).Unit

        -- Apply aligned camera CFrame — only direction changes, position stays
        Camera.CFrame = CFrame.new(Camera.CFrame.Position) * CFrame.fromMatrix(
            Vector3.zero,
            lerpedDir:Cross(Vector3.new(0,1,0)).Unit * -1,
            lerpedDir:Cross(lerpedDir:Cross(Vector3.new(0,1,0)).Unit * -1),
            -lerpedDir
        )

        -- Only fire when camera is actually close enough to target
        -- (prevents wild shots during lerp travel)
        local angleToTarget = math.deg(math.acos(
            math.clamp(currentDir:Dot(targetDir), -1, 1)
        ))
        if angleToTarget <= SILENT_HIT_FOV then
            fireTool()
        end
    end)
end

local function stopSilentAim()
    if silentAimConn then
        silentAimConn:Disconnect()
        silentAimConn = nil
    end
end

SAimBtn.MouseButton1Click:Connect(function()
    silentAimEnabled = not silentAimEnabled
    if silentAimEnabled then
        activateBtn(SAimDot, SAimBar, SAimStatus, Color3.fromRGB(80, 160, 255))
        startSilentAim()
    else
        deactivateBtn(SAimDot, SAimBar, SAimStatus)
        stopSilentAim()
    end
end)

-- ══════════════════════════════════
--  UNLOCK ALL COSMETICS (LOCAL)
--  Full RS + workspace scan:
--  skins, wraps, finishers, effects
-- ══════════════════════════════════

local COSMETIC_KEYWORDS = {
    "skin","wrap","finisher","kill","effect",
    "cosmetic","item","hat","accessory","bundle",
    "trail","aura","animation","emote","victory","glove"
}

local function isCosmetic(obj)
    local name = obj.Name:lower()
    for _, kw in ipairs(COSMETIC_KEYWORDS) do
        if name:find(kw) then return true end
    end
    return false
end

local function tryFireEquipRemote(obj, char)
    for _, desc in ipairs(obj:GetDescendants()) do
        pcall(function()
            if desc:IsA("RemoteEvent") then
                desc:FireServer(char, obj)
            end
        end)
    end
end

local function tryGlobalEquipRemotes(obj)
    local remoteNames = {
        "EquipSkin","ApplySkin","SetSkin",
        "EquipWrap","ApplyWrap","SetWrap",
        "EquipFinisher","ApplyFinisher","SetFinisher",
        "EquipCosmetic","ApplyCosmetic","Equip","Apply"
    }
    for _, name in ipairs(remoteNames) do
        local r = ReplicatedStorage:FindFirstChild(name, true)
        if r and r:IsA("RemoteEvent") then
            pcall(function() r:FireServer(obj) end)
        end
    end
end

local function scanAndEquipCosmetics()
    local char = getChar()
    if not char then return 0 end
    local equipped = 0
    local seen = {}

    -- PASS 1: full ReplicatedStorage scan
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if seen[obj.Name] then continue end
        pcall(function()
            if obj:IsA("Accessory") then
                obj:Clone().Parent = char
                equipped = equipped + 1
                seen[obj.Name] = true
            elseif obj:IsA("Model") and isCosmetic(obj) then
                tryFireEquipRemote(obj, char)
                tryGlobalEquipRemotes(obj)
                equipped = equipped + 1
                seen[obj.Name] = true
            elseif (obj:IsA("StringValue") or obj:IsA("IntValue")) then
                local nm = obj.Name:lower()
                if nm:find("skin") or nm:find("wrap") or nm:find("finish") then
                    tryGlobalEquipRemotes(obj)
                    equipped = equipped + 1
                    seen[obj.Name] = true
                end
            elseif obj:IsA("Folder") and isCosmetic(obj) then
                for _, child in ipairs(obj:GetChildren()) do
                    if not seen[child.Name] then
                        if child:IsA("Accessory") then
                            child:Clone().Parent = char
                        else
                            tryFireEquipRemote(child, char)
                            tryGlobalEquipRemotes(child)
                        end
                        equipped = equipped + 1
                        seen[child.Name] = true
                    end
                end
            end
        end)
    end

    -- PASS 2: clone accessories from other players in server
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local c = p.Character
        if not c then continue end
        for _, obj in ipairs(c:GetChildren()) do
            if obj:IsA("Accessory") and not seen[obj.Name] then
                pcall(function()
                    obj:Clone().Parent = char
                    equipped = equipped + 1
                    seen[obj.Name] = true
                end)
            end
        end
    end

    -- PASS 3: workspace cosmetic scan
    for _, obj in ipairs(workspace:GetDescendants()) do
        if seen[obj.Name] then continue end
        if obj:IsA("Accessory") and isCosmetic(obj) then
            pcall(function()
                obj:Clone().Parent = char
                equipped = equipped + 1
                seen[obj.Name] = true
            end)
        end
    end

    print("[RivalsHub] Cosmetics applied:", equipped)
    return equipped
end

CosBtn.MouseButton1Click:Connect(function()
    cosmeticsUnlocked = not cosmeticsUnlocked
    if cosmeticsUnlocked then
        activateBtn(CosDot, CosBar, CosStatus, Color3.fromRGB(180, 120, 255))
        local n = scanAndEquipCosmetics()
        CosStatus.Text = "ON · " .. n .. " items"
        LocalPlayer.CharacterAdded:Connect(function()
            if cosmeticsUnlocked then
                task.wait(1)
                scanAndEquipCosmetics()
            end
        end)
    else
        deactivateBtn(CosDot, CosBar, CosStatus)
        local char = getChar()
        if char then
            for _, obj in ipairs(char:GetChildren()) do
                if obj:IsA("Accessory") then obj:Destroy() end
            end
        end
    end
end)

