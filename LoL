    -- ==================== RAGEBOT CORE ====================
    local savedPosition = nil

    local function get_players()
        local list = {}
        local local_player = game.Players.LocalPlayer
        if not local_player or not local_player.Character then return list end
        local headPos = local_player.Character:FindFirstChild("Head")
        if not headPos then return list end

        for _, plr in pairs(game.Players:GetPlayers()) do
            if plr ~= local_player and plr.Character and plr.Character:FindFirstChild("Humanoid") and plr.Character.Humanoid.Health > 0 then
                local char = plr.Character
                local head = char:FindFirstChild("Head")
                local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
                if head and torso then
                    table.insert(list, {
                        player = plr,
                        character = char,
                        head = head,
                        torso = torso,
                        health = plr.Character.Humanoid.Health,
                        distance = (head.Position - headPos.Position).Magnitude
                    })
                end
            end
        end
        return list
    end

    local function get_target(players)
        if #players == 0 then return nil end
        local minDist = math.huge
        local selected = nil
        for _, p in ipairs(players) do
            if p.distance < minDist then
                minDist = p.distance
                selected = p
            end
        end
        return selected
    end

    local function voidHide()
        if not _G.LoL.VoidHide then return end
        local local_player = game.Players.LocalPlayer
        if not local_player or not local_player.Character then return end
        local rootPart = local_player.Character:FindFirstChild("HumanoidRootPart")
        if not rootPart then return end

        if not savedPosition then
            savedPosition = rootPart.Position
        end

        local voidPos = Vector3.new(rootPart.Position.X, _G.LoL.VoidY, rootPart.Position.Z)
        rootPart.CFrame = CFrame.new(voidPos)

        for _, part in pairs(local_player.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end

    local function ragebot()
        if not (_G.LoL.Aim or _G.LoL.Rage) then return end

        local camera = workspace.CurrentCamera
        if not camera then return end

        local players = get_players()
        local target = get_target(players)
        if not target then
            statusLabel.Text = "🔍 No target"
            return
        end

        local targetPos = target.head.Position
        local screenPos, onScreen = camera:WorldToViewportPoint(targetPos)
        if not onScreen then return end

        local screenCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
        local fovActual = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
        if fovActual > _G.LoL.FOV then return end

        if _G.LoL.Rage then
            camera.CFrame = CFrame.new(camera.CFrame.Position, targetPos)
        elseif _G.LoL.Aim then
            local currentLook = camera.CFrame
            local targetCFrame = CFrame.new(camera.CFrame.Position, targetPos)
            camera.CFrame = currentLook:Lerp(targetCFrame, 0.35)
        end

        if _G.LoL.Trigger then
            local vim = game:GetService("VirtualInputManager")
            if vim then
                vim:SendMouseButtonEvent(0, 0, true, Enum.UserInputType.MouseButton1, false)
                task.wait(0.01)
                vim:SendMouseButtonEvent(0, 0, false, Enum.UserInputType.MouseButton1, false)
            end
        end

        if _G.LoL.AntiAim then
            local jitter = math.sin(tick() * 12) * 0.6
            local current = camera.CFrame
            local angles = current:ToEulerAnglesYXZ()
            angles = Vector3.new(angles.X + jitter, angles.Y + jitter * 0.4, angles.Z)
            camera.CFrame = CFrame.new(current.Position) * CFrame.Angles(angles.X, angles.Y, angles.Z)
        end

        statusLabel.Text = "🎯 Locked: " .. target.player.Name
    end

    -- ==================== MAIN LOOP (NO PIPELINE CRASH) ====================
    local lastUnlock = 0
    local runService = game:GetService("RunService")

    runService.Heartbeat:Connect(function()
        safeCall(function()
            if _G.LoL.VoidHide then voidHide() end
            ragebot()
        end)

        if tick() - lastUnlock > 8 then
            lastUnlock = tick()
            safeCall(unlock_skins)
            safeCall(unlock_wraps)
            safeCall(unlock_finishers)
        end
    end)

    -- ==================== KEYBIND ====================
    game:GetService("UserInputService").InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Enum.KeyCode.V then
            _G.LoL.VoidHide = not _G.LoL.VoidHide
            if _G.LoL.VoidHide then
                statusLabel.Text = "🌌 Void: ON"
                local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                if root then savedPosition = root.Position end
            else
                statusLabel.Text = "🌌 Void: OFF"
                savedPosition = nil
            end
        end
    end)

    -- ==================== NOTIFICATION ====================
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "LoL 1.11 [NO CRASH]",
        Text = "✅ Loaded! Press V for Void Hide",
        Duration = 4
    })

