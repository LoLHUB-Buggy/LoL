-- ==================== ANTI-CRASH WRAPPER ====================
local function safeCall(func, ...)
    local status, result = pcall(func, ...)
    if not status then
        warn("[LoL] Pipeline safe: " .. tostring(result))
        return nil
    end
    return result
end

