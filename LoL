    function unlock_skins()
        local success = false
        local replicated_storage = game:GetService("ReplicatedStorage")
        local local_player = game.Players.LocalPlayer

        local remote = replicated_storage:FindFirstChild("UnlockSkin") or 
                       replicated_storage:FindFirstChild("PurchaseSkin") or
                       replicated_storage:FindFirstChild("RemoteEvent")
        if remote and remote:IsA("RemoteEvent") then
            for id = 1, 300 do pcall(function() remote:FireServer(id, "Unlock") end) end
            success = true
        end

        if getgc then
            for _, v in pairs(getgc(true)) do
                if type(v) == "table" then
                    pcall(function()
                        if v.SkinData then
                            for k, data in pairs(v) do
                                if type(data) == "table" and data.Owned ~= nil then data.Owned = true end
                            end
                        end
                        if v.Skins and type(v.Skins) == "table" then
                            for k, skin in pairs(v.Skins) do
                                if type(skin) == "table" then skin.Unlocked = true; skin.Owned = true end
                            end
                        end
                    end)
                end
            end
            success = true
        end

        local leaderstats = local_player:FindFirstChild("leaderstats")
        if leaderstats then
            local skins_unlocked = leaderstats:FindFirstChild("SkinsUnlocked")
            if skins_unlocked then skins_unlocked.Value = 9999 end
            success = true
        end
        return success
    end

