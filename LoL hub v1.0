-- Modern Button Creator Helper
local function createButton(text, callback)
    local btn = Instance.new("TextButton")
    btn.Parent = ScrollContainer
    btn.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
    btn.Size = UDim2.new(1, -10, 0, 42)
    btn.Font = Enum.Font.GothamMedium
    btn.Text = "   " .. text
    btn.TextColor3 = Color3.fromRGB(230, 230, 230)
    btn.TextSize = 14
    btn.TextXAlignment = Enum.TextXAlignment.Left
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = btn
    
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(45, 45, 60)
    stroke.Thickness = 1
    stroke.Parent = btn
    
    local indicator = Instance.new("Frame")
    indicator.Name = "Indicator"
    indicator.Parent = btn
    indicator.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
    indicator.Position = UDim2.new(1, -32, 0.5, -10)
    indicator.Size = UDim2.new(0, 20, 0, 20)
    
    local indCorner = Instance.new("UICorner")
    indCorner.CornerRadius = UDim.new(0, 4)
    indCorner.Parent = indicator
    
    local active = false
    btn.MouseButton1Click:Connect(function()
        active = not active
        if active then
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(60, 15, 15)}):Play()
            TweenService:Create(stroke, TweenInfo.new(0.2), {Color3 = Color3.fromRGB(255, 50, 50)}):Play()
            TweenService:Create(indicator, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(255, 50, 50)}):Play()
        else
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(25, 25, 35)}):Play()
            TweenService:Create(stroke, TweenInfo.new(0.2), {Color3 = Color3.fromRGB(45, 45, 60)}):Play()
            TweenService:Create(indicator, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(80, 80, 80)}):Play()
        end
        callback(active)
    end)
    return btn
end

-- 1. Deep-Recursive Unlock All Skins, Wraps & Finishers
createButton("Unlock All Skins, Wraps & Finishers", function(state)
    pcall(function()
        local function deepUnlock(tbl, visited)
            visited = visited or {}
            if visited[tbl] then return end
            visited[tbl] = true

            for k, v in pairs(tbl) do
                local keyStr = tostring(k):lower()
                if type(v) == "boolean" then
                    if keyStr:find("skin") or keyStr:find("wrap") or keyStr:find("finisher") or keyStr:find("unlock") or keyStr:find("owned") then
                        tbl[k] = true
                    end
                elseif type(v) == "table" then
                    if keyStr:find("skin") or keyStr:find("wrap") or keyStr:find("finisher") or keyStr:find("inventory") or keyStr:find("arsenal") then
                        for subK, _ in pairs(v) do
                            v[subK] = true
                        end
                    end
                    deepUnlock(v, visited)
                end
            end
        end

        for _, obj in pairs(getgc(true)) do
            if type(obj) == "table" then
                deepUnlock(obj)
            end
        end
    end)
end)

-- 2. Silent Aim (Toggle Runtime Camera Alignment)
local silentAimEnabled = false
createButton("Toggle Runtime Camera Alignment (Silent Aim)", function(state)
    silentAimEnabled = state
end)

RunService.RenderStepped:Connect(function()
    if silentAimEnabled then
        pcall(function()
            local camera = Workspace.CurrentCamera
            local closestTarget = nil
            local shortestDistance = math.huge
            
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
                    if humanoid and humanoid.Health > 0 then
                        local pos, onScreen = camera:WorldToViewportPoint(player.Character.HumanoidRootPart.Position)
                        if onScreen then
                            local magnitude = (Vector2.new(pos.X, pos.Y) - UserInputService:GetMouseLocation()).Magnitude
                            if magnitude < shortestDistance then
                                shortestDistance = magnitude
                                closestTarget = player.Character.HumanoidRootPart
                            end
                        end
                    end
                end
            end
            
            if closestTarget then
                camera.CFrame = CFrame.new(camera.CFrame.Position, closestTarget.Position)
            end
        end)
    end
end)

-- 3. Triggerbot
local triggerbotEnabled = false
createButton("Triggerbot (Auto Fire on Crosshair Target)", function(state)
    triggerbotEnabled = state
end)

RunService.RenderStepped:Connect(function()
    if triggerbotEnabled then
        pcall(function()
            local camera = Workspace.CurrentCamera
            local mouseLoc = UserInputService:GetMouseLocation()
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
                    local hum = player.Character:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then
                        local screenPos, onScreen = camera:WorldToViewportPoint(player.Character.Head.Position)
                        if onScreen then
                            local dist = (Vector2.new(screenPos.X, screenPos.Y) - mouseLoc).Magnitude
                            if dist < 25 then
                                local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
                                if tool then
                                    tool:Activate()
                                end
                            end
                        end
                    end
                end
            end
        end)
    end
end)

-- Variables for Melee Aura & Attack Speed Adjustment
local meleeAuraEnabled = false
local attackSpeedRate = 0.5 -- Default attack/tp rate in seconds

-- 4. Melee Aura (Auto-detects active combat enemy, TP follows & attacks, pauses when turned off)
createButton("Melee Aura (Auto-Detect Target & TP Follow)", function(state)
    meleeAuraEnabled = state
end)

-- 5. Attack Speed Adjustment Slider (1 - 10 seconds / tick frequency)
local speedSliderFrame = Instance.new("Frame")
speedSliderFrame.Parent = ScrollContainer
speedSliderFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
speedSliderFrame.Size = UDim2.new(1, -10, 0, 60)

local spCorner = Instance.new("UICorner")
spCorner.CornerRadius = UDim.new(0, 8)
spCorner.Parent = speedSliderFrame

local spStroke = Instance.new("UIStroke")
spStroke.Color = Color3.fromRGB(45, 45, 60)
spStroke.Parent = speedSliderFrame

local spLabel = Instance.new("TextLabel")
spLabel.Parent = speedSliderFrame
spLabel.BackgroundTransparency = 1
spLabel.Position = UDim2.new(0, 15, 0, 8)
spLabel.Size = UDim2.new(1, -30, 0, 20)
spLabel.Font = Enum.Font.GothamMedium
spLabel.Text = "Melee Attack Speed Delay (1 - 10s): 0.5s"
spLabel.TextColor3 = Color3.fromRGB(230, 230, 230)
spLabel.TextSize = 13
spLabel.TextXAlignment = Enum.TextXAlignment.Left

local speedBar = Instance.new("TextButton")
speedBar.Parent = speedSliderFrame
speedBar.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
speedBar.Position = UDim2.new(0, 15, 0, 35)
speedBar.Size = UDim2.new(1, -30, 0, 12)
speedBar.Text = ""
speedBar.AutoButtonColor = false

local sbCorner = Instance.new("UICorner")
sbCorner.CornerRadius = UDim.new(0, 6)
sbCorner.Parent = speedBar

local speedFill = Instance.new("Frame")
speedFill.Parent = speedBar
speedFill.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
speedFill.Size = UDim2.new(0.05, 0, 1, 0)

local sfCorner = Instance.new("UICorner")
sfCorner.CornerRadius = UDim.new(0, 6)
sfCorner.Parent = speedFill

local draggingSpeedSlider = false
speedBar.MouseButton1Down:Connect(function()
    draggingSpeedSlider = true
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingSpeedSlider = false
    end
end)

RunService.RenderStepped:Connect(function()
    if draggingSpeedSlider then
        local mousePos = UserInputService:GetMouseLocation().X
        local barAbsolutePos = speedBar.AbsolutePosition.X
        local barAbsoluteSize = speedBar.AbsoluteSize.X
        local relX = math.clamp(mousePos - barAbsolutePos, 0, barAbsoluteSize)
        local percentage = relX / barAbsoluteSize
        
        speedFill.Size = UDim2.new(percentage, 0, 1, 0)
        attackSpeedRate = math.clamp(math.floor(1 + (percentage * 9) + 0.5), 1, 10)
        spLabel.Text = "Melee Attack Speed Delay (1 - 10s): " .. tostring(attackSpeedRate) .. "s"
    end
end)

-- Melee Aura Loop (TP Follow + Active Target Detection + Instant Pause Handling)
task.spawn(function()
    while true do
        if meleeAuraEnabled then
            pcall(function()
                local character = LocalPlayer.Character
                if character and character:FindFirstChild("HumanoidRootPart") then
                    local rootPart = character.HumanoidRootPart
                    local currentTarget = nil
                    local shortestDist = math.huge
                    
                    -- Auto-detect player that is currently closest/being fought
                    for _, player in ipairs(Players:GetPlayers()) do
                        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                            local hum = player.Character:FindFirstChildOfClass("Humanoid")
                            if hum and hum.Health > 0 then
                                local dist = (rootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
                                if dist < shortestDist then
                                    shortestDist = dist
                                    currentTarget = player.Character.HumanoidRootPart
                                end
                            end
                        end
                    end
                    
                    if currentTarget then
                        -- TP Follow immediately behind/near the target
                        rootPart.CFrame = currentTarget.CFrame * CFrame.new(0, 0, 3)
                        
                        -- Activate tool/weapon
                        local tool = character:FindFirstChildOfClass("Tool")
                        if tool then
                            tool:Activate()
                        end
                    end
                end
            end)
            task.wait(attackSpeedRate)
        else
            -- Paused immediately when toggled off
            task.wait(0.2)
        end
    end
end)

-- 6. Teleport to Nearest Player
createButton("Teleport to Nearest Player", function(state)
    pcall(function()
        local character = LocalPlayer.Character
        if not character or not character:FindFirstChild("HumanoidRootPart") then return end
        local rootPart = character.HumanoidRootPart
        
        local closestTarget = nil
        local shortestDist = math.huge
        
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local hum = player.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local dist = (rootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        closestTarget = player.Character.HumanoidRootPart
                    end
                end
            end
        end
        
        if closestTarget then
            rootPart.CFrame = closestTarget.CFrame + Vector3.new(0, 3, 0)
        end
    end)
end)

-- 7. Hide Void & Anti-Void (-999k Y Level Protection)
local antiVoidEnabled = false
createButton("Hide Void & Anti-Void (-999k Y Level Protection)", function(state)
    antiVoidEnabled = state
end)

RunService.Stepped:Connect(function()
    if antiVoidEnabled then
        pcall(function()
            local character = LocalPlayer.Character
            if character and character:FindFirstChild("HumanoidRootPart") then
                local root = character.HumanoidRootPart
                if root.Position.Y < -500 then
                    root.CFrame = CFrame.new(root.Position.X, 50, root.Position.Z)
                    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                end
            end
        end)
    end
end)

