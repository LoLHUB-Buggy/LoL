--[[
    LoL Hub - Roblox Rivals Script (Advanced Melee Aura & Combat Edition)
    Features: Modern Cyberpunk GUI, Draggable & Collapsible Mobile Support,
    Melee Aura with Instant TP Follow, Auto-Target Active Combat Enemy, Attack Speed Adjustment (1-10s/ticks),
    Teleport to Player, Void Protection & Anti-Void (-999k Y-Level), Height Adjustment Slider (1-50),
    Triggerbot, Silent Aim (Runtime Camera Alignment), Fly, Noclip, 
    Deep-Recursive Unlock All Skins, Wraps & Finishers, Anti-Crash Loop
]]--

if not game:IsLoaded() then
    game.Loaded:Wait()
end

-- Anti-Crash & Anti-Pipeline-Crash Protection Loop
task.spawn(function()
    while true do
        task.wait(1)
        pcall(function()
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
            game:GetService("Stats").DataReceiveKbps:GetPropertyChangedSignal():Connect(function()end)
        end)
    end
end)

